# HyperDrive development configuration template.
#
# Copy to .env and fill in values:   Copy-Item .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# WHO READS WHAT (important):
#   * Docker Compose reads ./.env automatically when you run `docker compose` in this folder.
#   * The backend and the desktop app do NOT read this file. They read process environment
#     variables. Set them in the PowerShell window that starts them, e.g.
#         $env:GOOGLE_CLIENT_ID = "..."
#     The backend/desktop sections below document the variables and their defaults.

# --- Docker Compose: PostgreSQL ------------------------------------------------------------
POSTGRES_DB=hyperdrive
POSTGRES_USER=hyperdrive
# Required. Choose a local development password.
POSTGRES_PASSWORD=change-me-local-dev-only
# Host port, bound to 127.0.0.1 only. Change it (e.g. 55432) if a native PostgreSQL already
# uses 5432 on your machine.
POSTGRES_PORT=5432

# --- Docker Compose: Redis (optional, only with `--profile redis`) ------------------------
# Not used by any code yet. Required only when the redis profile is started.
REDIS_PASSWORD=change-me-local-dev-only
REDIS_PORT=6379

# --- Backend (Spring Boot) -- set in the shell; NOT loaded from this file -------------------
# Interface and port to listen on. Keep loopback for development.
# HYPERDRIVE_BACKEND_ADDRESS=127.0.0.1
# HYPERDRIVE_BACKEND_PORT=18080
#
# Sign-in is OFF unless the auth profile is active. Without it the backend serves only
# /api/v1/health and /api/v1/ready (no database needed) and the desktop shows
# "Sign-in isn't enabled".
# SPRING_PROFILES_ACTIVE=auth
#
# Required when SPRING_PROFILES_ACTIVE=auth:
#   Database (match the Compose values above; note the port).
# HYPERDRIVE_DB_URL=jdbc:postgresql://127.0.0.1:5432/hyperdrive
# HYPERDRIVE_DB_USERNAME=hyperdrive
# HYPERDRIVE_DB_PASSWORD=<same as POSTGRES_PASSWORD>
#   Google OAuth client (Google Cloud Console -> "Web application"). The secret stays on the
#   backend only. Never put it in desktop or renderer configuration.
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-client-secret>
#   Origin the user's browser uses to reach the backend. The Google redirect URI is
#   <this>/login/oauth2/code/google and must be registered exactly in Google Cloud Console.
# HYPERDRIVE_PUBLIC_BASE_URL=http://127.0.0.1:18080
#   Set true when the public base URL is https (marks the sign-in cookie Secure).
# HYPERDRIVE_SECURE_COOKIES=false
#
#   Google Drive connections (Batch 3). Required in auth mode: the key that encrypts stored
#   Google tokens (AES-256-GCM). Base64 of exactly 32 random bytes; no default. Generate with
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Keep it secret and stable: a different key makes stored connections unreadable (reconnect).
# HYPERDRIVE_CREDENTIAL_KEY=<base64 of 32 random bytes>
# HYPERDRIVE_CREDENTIAL_KEY_VERSION=1
#   Key rotation only: old keys still accepted for decryption, "version:base64,...".
# HYPERDRIVE_CREDENTIAL_PREVIOUS_KEYS=
#   Optional separate OAuth client for Drive consent (defaults to GOOGLE_CLIENT_ID/SECRET).
#   Its redirect URI is <HYPERDRIVE_PUBLIC_BASE_URL>/api/v1/storage-connections/google/callback
#   (register it in Google Cloud Console in addition to the sign-in redirect URI).
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
#
#   Dropbox connections (Batch 4), optional. Leave BOTH empty to disable Dropbox; setting only one
#   fails startup. Create a "Scoped access" app with "Full Dropbox" access, enable the scopes
#   account_info.read, files.metadata.read and files.content.read (Batch 6 bounded reads; older
#   connections need a reconnect), and register the redirect URI
#   <HYPERDRIVE_PUBLIC_BASE_URL>/api/v1/storage-connections/dropbox/callback (see docs/dropbox.md).
#   The secret stays on the backend only.
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# --- Desktop main process (Electron) -- set in the shell; NOT loaded from this file ---------
# Trusted backend origin. https required, except http to 127.0.0.1/localhost/[::1] for local
# development (provider access tokens are delegated over this connection since Batch 6).
# Origin only: no path, query or credentials. Read by the
# Electron main process only; never exposed to the UI. For sign-in it must be the SAME origin
# as HYPERDRIVE_PUBLIC_BASE_URL (the app only opens authorization URLs on this origin).
# HYPERDRIVE_BACKEND_URL=http://127.0.0.1:18080
#
# Local agent (Batch 5). The desktop starts it automatically; these are optional overrides read by
# the Electron main process only. The agent's secret is generated per launch and never configured.
#   Absolute path to java.exe (21+). Otherwise JAVA_HOME\bin\java.exe, then "java" on PATH.
# HYPERDRIVE_AGENT_JAVA=C:\Program Files\Java\jdk-21\bin\java.exe
#   Absolute path to the agent jar. Default in development: <repo>\agent\target\hyperdrive-agent.jar
# HYPERDRIVE_AGENT_JAR=
#   ERROR | WARN | INFO | DEBUG (agent stderr)
# HYPERDRIVE_AGENT_LOG_LEVEL=INFO
